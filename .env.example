# Runtime environment: dev, test, or prod.
APP_ENV=dev

# Local Docker Compose defaults. Use injected secrets/URLs outside local development.
DATABASE_URL=postgresql://postgres:postgres@db:5432/stock_db
REDIS_URL=redis://redis:6379/0

# Security settings. Replace SECRET_KEY in every real environment; never commit real secrets.
SECRET_KEY=change-me-to-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=2880

# Optional LLM provider settings. Leave OPENAI_API_KEY empty for mock-only local flows.
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint override for local proxy tools.
# When the backend runs inside Docker Compose and the proxy runs on the host,
# use http://host.docker.internal:10531/v1.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5
LLM_TIMEOUT_SECONDS=30
# Local dev uses mock; launch default in code is cloud.
LLM_PROVIDER=mock
# Empty means unlimited. Applies only when LLM_PROVIDER=cloud.
LLM_DAILY_CALL_LIMIT=
# Empty disables response caching. Applies only when LLM_PROVIDER=cloud.
LLM_CACHE_TTL_SECONDS=
# Enables risk escalation policy attachment. Applies only when LLM_PROVIDER=cloud.
# Current launch routing is cloud-only, so this becomes effective when local routing is introduced.
LLM_ESCALATION_ENABLED=false
# Empty disables confidence-triggered escalation. Applies only when LLM_PROVIDER=cloud.
# Current launch routing is cloud-only, so this becomes effective when local routing is introduced.
LLM_ESCALATION_CONFIDENCE_THRESHOLD=

# Analysis session-band schedules are opt-in for dev/demo profile separation.
ANALYSIS_SCHEDULE_ENABLED=false

# Data provider switches: mock uses deterministic local adapters, real selects external adapters.
# Real providers are only valid where the corresponding adapter and credentials are configured.
MARKET_PROVIDER=mock
NEWS_PROVIDER=mock
NEWS_QUERY_URL_TEMPLATE=https://news.google.com/rss/search?q={query}&hl={hl}&gl={gl}&ceid={gl}:{hl}
DISCLOSURE_PROVIDER=mock
PORTFOLIO_PROVIDER=mock

# CORS settings for browser-based frontends.
# Local development example:
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Production example:
# CORS_ORIGINS=https://app.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=false
